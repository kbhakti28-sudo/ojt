<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhakti Kumbhar | Portfolio</title>
  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      line-height:1.6;
      background:#f5f7fa;
      color:#333;
    }

    header{
      background:linear-gradient(135deg,#4f46e5,#7c3aed);
      color:white;
      text-align:center;
      padding:80px 20px;
    }

    header h1{
      font-size:3rem;
      margin-bottom:10px;
    }

    header p{
      font-size:1.2rem;
      opacity:0.9;
    }

    .btn{
      display:inline-block;
      margin-top:20px;
      padding:12px 25px;
      background:white;
      color:#4f46e5;
      text-decoration:none;
      border-radius:30px;
      font-weight:bold;
      transition:0.3s;
    }

    .btn:hover{
      background:#e0e7ff;
    }

    section{
      max-width:1100px;
      margin:auto;
      padding:60px 20px;
    }

    h2{
      text-align:center;
      margin-bottom:40px;
      font-size:2rem;
      color:#4f46e5;
    }

    .about{
      text-align:center;
      max-width:800px;
      margin:auto;
      font-size:1.05rem;
    }

    .skills{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
      gap:20px;
      margin-top:20px;
    }

    .skill{
      background:white;
      padding:20px;
      text-align:center;
      border-radius:15px;
      box-shadow:0 4px 10px rgba(0,0,0,0.08);
      font-weight:bold;
      transition:transform 0.3s;
    }

    .skill:hover{
      transform:translateY(-5px);
    }

    .projects{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:25px;
    }

    .project{
      background:white;
      padding:25px;
      border-radius:15px;
      box-shadow:0 4px 10px rgba(0,0,0,0.08);
      transition:transform 0.3s;
    }

    .project:hover{
      transform:translateY(-5px);
    }

    .project h3{
      margin-bottom:10px;
      color:#111827;
    }

    .contact{
      text-align:center;
    }

    .contact p{
      margin:10px 0;
      font-size:1.05rem;
    }

    footer{
      text-align:center;
      padding:20px;
      background:#111827;
      color:white;
      margin-top:40px;
    }

    @media (max-width:768px){
      header{
        padding:60px 15px;
      }

      header h1{
        font-size:2.2rem;
      }

      header p{
        font-size:1rem;
      }

      h2{
        font-size:1.6rem;
      }

      section{
        padding:50px 15px;
      }
    }

    @media (max-width:480px){
      header h1{
        font-size:1.9rem;
      }

      .btn{
        padding:10px 20px;
        font-size:0.95rem;
      }

      .skill,
      .project{
        padding:18px;
      }
    }
  </style>
</head>
<body>

  <!-- Hero Section -->
  <header>
    <h1>Bhakti Kumbhar</h1>
    <p>B.Sc. Computer Science | Front-End Developer</p>
    <a href="#contact" class="btn">Contact Me</a>
  </header>

  <!-- About -->
  <section id="about">
    <h2>About Me</h2>
    <div class="about">
      <p>
        Hello! I am <strong>Bhakti Kumbhar</strong>, a B.Sc. Computer Science student and an aspiring
        <strong>Front-End Developer</strong>. I enjoy creating clean, responsive, and user-friendly websites
        using <strong>HTML</strong> and <strong>CSS</strong>. I am passionate about web development and continuously
        learning new technologies to improve my skills.
      </p>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills">
    <h2>Skills</h2>
    <div class="skills">
      <div class="skill">HTML5</div>
      <div class="skill">CSS3</div>
      <div class="skill">Responsive Design</div>
      <div class="skill">C</div>
      <div class="skill">C++</div>
      <div class="skill">Java (Basic)</div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <h2>Projects</h2>
    <div class="projects">

      <div class="project">
        <h3>Personal Portfolio</h3>
        <p>A responsive portfolio website built using HTML and CSS.</p>
      </div>

      <div class="project">
        <h3>Calculator App</h3>
        <p>Basic calculator project created during my programming internship.</p>
      </div>

      <div class="project">
        <h3>Responsive Landing Page</h3>
        <p>A modern landing page layout optimized for mobile and desktop devices.</p>
      </div>

    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <h2>Contact</h2>
    <div class="contact">
      <p><strong>Name:</strong> Bhakti Kumbhar</p>
      <p><strong>Education:</strong> B.Sc. Computer Science (Third Year)</p>
      <p><strong>Role:</strong> Front-End Developer</p>
      <p><strong>Email:</strong> your-email@example.com</p>
      <p><strong>Location:</strong> Maharashtra, India</p>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2026 Bhakti Kumbhar | All Rights Reserved</p>
  </footer>

</body>
</html>